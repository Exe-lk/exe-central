generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SystemRole {
  ADMINISTRATOR
  PROJECT_MANAGER
  FINANCE
  HR
  MANAGEMENT
}

enum AccountState {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model User {
  // This ID must exactly match the UUID generated by Supabase auth.users
  id        String       @id @db.Uuid
  name      String       @db.VarChar(150)
  email     String       @unique @db.VarChar(255)
  role      SystemRole   @default(ADMINISTRATOR)
  status    AccountState @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("users")
}

// ==================================================
// 1. CORE PROJECT & CENTRAL CONFIGURATION
// ==================================================

enum ProjectType {
  OUTSOURCING
  INDUSTRIAL
}

enum ProjectStatus {
  DRAFT
  IN_PROGRESS
  PENDING_REVIEW
  COMPLETED
  CANCELLED
}

model Project {
  id         String @id @default(uuid()) @db.Uuid
  sequenceNo Int    @unique @default(autoincrement()) @map("sequence_no")
  projectNo  String @unique @map("project_no")

  name          String
  clientName    String  @map("client_name")
  clientCompany String? @map("client_company")
  clientEmail   String? @map("client_email")
  clientPhone   String? @map("client_phone")
  clientAddress String? @map("client_address")
  country       String?

  type           ProjectType
  status         ProjectStatus @default(DRAFT)
  startDate      DateTime?     @map("start_date")
  endDate        DateTime?     @map("end_date")
  projectManager String?       @map("project_manager")
  description    String?       @db.Text

  // Google Drive Master Folder integration
  driveFolderId String? @map("drive_folder_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  outsourcingProject OutsourcingProject?
  industrialProject  IndustrialProject?

  proposals      Proposal[]
  quotations     Quotation[]
  invoices       Invoice[]
  payments       Payment[]
  receipts       Receipt[]
  documentSeries ProjectDocumentSeries[]

  @@map("projects")
}

model CompanyBankDetail {
  id          String  @id @default(uuid()) @db.Uuid
  accountNo   String  @map("account_no")
  accountName String  @map("account_name")
  swiftCode   String  @map("swift_code")
  bankName    String  @map("bank_name")
  branchName  String  @map("branch_name")
  address     String
  country     String
  isDefault   Boolean @default(true) @map("is_default")

  @@map("company_bank_details")
}

// ==================================================
// 1.5 DOCUMENT NUMBERING ENGINE
// ==================================================

enum DocumentType {
  INVOICE
  RECEIPT
  QUOTATION
  COST_ESTIMATION
}

model GlobalDocumentSequence {
  type      DocumentType @id
  prefix    String
  nextValue Int          @default(1)

  @@map("global_document_sequences")
}

model ProjectDocumentSeries {
  id           String       @id @default(uuid()) @db.Uuid
  projectId    String       @db.Uuid
  documentType DocumentType
  rootNumber   String       @unique
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, documentType])
  @@map("project_document_series")
}

// ==================================================
// 2. OUTSOURCING SPECIFIC WORKFLOW
// ==================================================

enum OutsourcingMode {
  INDIVIDUAL
  GROUP
}

model OutsourcingProject {
  id        String          @id @default(uuid()) @db.Uuid
  projectId String          @unique @db.Uuid
  mode      OutsourcingMode

  project         Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  participants    OutsourcingParticipant[]
  package         ProjectPackage?
  additionalCosts OutsourcingAdditionalCost[]

  @@map("outsourcing_projects")
}

model OutsourcingParticipant {
  id                   String @id @default(uuid()) @db.Uuid
  outsourcingProjectId String @db.Uuid
  code                 String
  name                 String

  outsourcingProject OutsourcingProject          @relation(fields: [outsourcingProjectId], references: [id], onDelete: Cascade)
  additionalCosts    OutsourcingAdditionalCost[]
  invoices           Invoice[]

  @@unique([outsourcingProjectId, code])
  @@map("outsourcing_participants")
}

model PackageTemplate {
  id             String              @id @default(uuid()) @db.Uuid
  name           String
  durationMonths Int
  totalAmount    Decimal             @db.Decimal(12, 2)
  milestones     TemplateMilestone[]

  @@map("package_templates")
}

model TemplateMilestone {
  id         String  @id @default(uuid()) @db.Uuid
  templateId String  @db.Uuid
  name       String
  amount     Decimal @db.Decimal(12, 2)
  order      Int

  template PackageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("template_milestones")
}

model ProjectPackage {
  id                   String  @id @default(uuid()) @db.Uuid
  outsourcingProjectId String  @unique @db.Uuid
  templateId           String? @db.Uuid
  name                 String
  totalAmount          Decimal @db.Decimal(12, 2)
  discountAmount       Decimal @default(0) @db.Decimal(12, 2)
  taxAmount            Decimal @default(0) @db.Decimal(12, 2)

  outsourcingProject OutsourcingProject     @relation(fields: [outsourcingProjectId], references: [id], onDelete: Cascade)
  milestones         OutsourcingMilestone[]

  @@map("project_packages")
}

enum MilestoneStatus {
  PENDING
  PAID
}

model OutsourcingMilestone {
  id        String          @id @default(uuid()) @db.Uuid
  packageId String          @db.Uuid
  name      String
  amount    Decimal         @db.Decimal(12, 2)
  dueDate   DateTime?       @map("due_date") @db.Date
  order     Int
  status    MilestoneStatus @default(PENDING)

  package  ProjectPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@map("outsourcing_milestones")
}

model OutsourcingAdditionalCost {
  id                   String  @id @default(uuid()) @db.Uuid
  outsourcingProjectId String  @db.Uuid
  participantId        String? @db.Uuid
  description          String
  amount               Decimal @db.Decimal(12, 2)

  outsourcingProject OutsourcingProject      @relation(fields: [outsourcingProjectId], references: [id], onDelete: Cascade)
  participant        OutsourcingParticipant? @relation(fields: [participantId], references: [id], onDelete: SetNull)

  @@map("outsourcing_additional_costs")
}

// ==================================================
// 3. INDUSTRIAL SPECIFIC WORKFLOW
// ==================================================

model IndustrialProject {
  id        String @id @default(uuid()) @db.Uuid
  projectId String @unique @db.Uuid

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("industrial_projects")
}

enum ProposalStatus {
  DRAFT
  FINAL
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

model Proposal {
  id         String         @id @default(uuid()) @db.Uuid
  projectId  String         @db.Uuid
  validUntil DateTime?      @map("valid_until") @db.Date
  status     ProposalStatus @default(DRAFT)

  sections           ProposalSection[]
  pricingItems       ProposalPricingItem[]
  maintenanceItems   ProposalMaintenanceItem[]
  hostingItems       ProposalHostingItem[]
  thirdPartyItems    ProposalThirdPartyItem[]
  changeRequestItems ProposalChangeRequestItem[]
  timelineItems      ProposalTimelineItem[]
  paymentPlans       ProposalPaymentPlan[]
  quotations         Quotation[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([projectId, status])
  @@index([projectId, createdAt])
  @@map("proposals")
}

model ProposalSection {
  id         String  @id @default(uuid()) @db.Uuid
  proposalId String  @db.Uuid
  title      String
  content    Json
  isIncluded Boolean @default(true) @map("is_included")
  order      Int

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId, order])
  @@map("proposal_sections")
}

enum PricingCategory {
  BASE_COST
  OPTIONAL_PRODUCT
  OPTIONAL_SERVICE
  AMC
  HOSTING
  THIRD_PARTY
}

model ProposalPricingItem {
  id               String          @id @default(uuid()) @db.Uuid
  proposalId       String          @db.Uuid
  category         PricingCategory
  title            String
  description      String?         @db.Text
  quantity         Decimal         @default(1) @db.Decimal(12, 2)
  unit             String?
  unitPrice        Decimal?        @map("unit_price") @db.Decimal(12, 2)
  amount           Decimal         @db.Decimal(12, 2)
  billingFrequency String?         @map("billing_frequency")
  isOptional       Boolean         @default(false) @map("is_optional")
  isIncluded       Boolean         @default(true) @map("is_included")
  order            Int

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId, category, order])
  @@map("proposal_pricing_items")
}

model ProposalMaintenanceItem {
  id              String  @id @default(uuid()) @db.Uuid
  proposalId      String  @db.Uuid
  maintenanceType String  @map("maintenance_type")
  description     String? @db.Text
  amount          Decimal @db.Decimal(12, 2)
  frequency       String?
  minimumDuration String? @map("minimum_duration")
  startPeriod     String? @map("start_period")
  isIncluded      Boolean @default(true) @map("is_included")
  order           Int

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId, order])
  @@map("proposal_maintenance_items")
}

model ProposalHostingItem {
  id             String  @id @default(uuid()) @db.Uuid
  proposalId     String  @db.Uuid
  provider       String?
  option         String?
  features       Json?
  cost           Decimal @db.Decimal(12, 2)
  billingPeriod  String? @map("billing_period")
  clientOwned    Boolean @default(false) @map("client_owned")
  deploymentInfo String? @map("deployment_info") @db.Text
  isIncluded     Boolean @default(true) @map("is_included")
  order          Int

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId, order])
  @@map("proposal_hosting_items")
}

model ProposalThirdPartyItem {
  id             String  @id @default(uuid()) @db.Uuid
  proposalId     String  @db.Uuid
  service        String
  description    String? @db.Text
  amount         Decimal @db.Decimal(12, 2)
  pricingPeriod  String? @map("pricing_period")
  responsibility String?
  notes          String? @db.Text
  isIncluded     Boolean @default(true) @map("is_included")
  order          Int

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId, order])
  @@map("proposal_third_party_items")
}

model ProposalChangeRequestItem {
  id          String  @id @default(uuid()) @db.Uuid
  proposalId  String  @db.Uuid
  description String  @db.Text
  rate        Decimal @db.Decimal(12, 2)
  unit        String?
  notes       String? @db.Text
  isIncluded  Boolean @default(true) @map("is_included")
  order       Int

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId, order])
  @@map("proposal_change_request_items")
}

model ProposalTimelineItem {
  id         String @id @default(uuid()) @db.Uuid
  proposalId String @db.Uuid
  phaseName  String @map("phase_name")
  duration   String
  order      Int

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId, order])
  @@map("proposal_timeline_items")
}

enum PaymentPlanType {
  PERCENTAGE
  FIXED
}

model ProposalPaymentPlan {
  id         String                    @id @default(uuid()) @db.Uuid
  proposalId String                    @db.Uuid
  name       String
  type       PaymentPlanType
  order      Int
  items      ProposalPaymentPlanItem[]

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId, order])
  @@map("proposal_payment_plans")
}

model ProposalPaymentPlanItem {
  id            String   @id @default(uuid()) @db.Uuid
  paymentPlanId String   @db.Uuid
  stage         String
  description   String?  @db.Text
  percentage    Decimal? @db.Decimal(7, 2)
  amount        Decimal? @db.Decimal(12, 2)
  timing        String?
  order         Int

  paymentPlan ProposalPaymentPlan @relation(fields: [paymentPlanId], references: [id], onDelete: Cascade)

  @@index([paymentPlanId, order])
  @@map("proposal_payment_plan_items")
}

model Quotation {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @db.Uuid
  proposalId  String?   @db.Uuid
  quotationNo String    @unique @map("quotation_no")
  validUntil  DateTime? @map("valid_until") @db.Date

  // Financial Snapshot
  subtotal       Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount    Decimal @map("total_amount") @db.Decimal(12, 2)

  items    QuotationItem[]
  invoices Invoice[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  proposal Proposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)

  @@map("quotations")
}

model QuotationItem {
  id               String          @id @default(uuid()) @db.Uuid
  quotationId      String          @db.Uuid
  category         PricingCategory
  title            String
  description      String?         @db.Text
  amount           Decimal         @db.Decimal(12, 2)
  billingFrequency String?         @map("billing_frequency")
  order            Int

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quotation_items")
}

// ==================================================
// 4. UNIFIED FINANCIAL PROCESS (OUTSOURCING & INDUSTRIAL)
// ==================================================

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  CANCELLED
}

model Invoice {
  id        String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid

  // Conditional links based on ProjectType
  participantId String? @db.Uuid
  milestoneId   String? @db.Uuid
  quotationId   String? @db.Uuid
  proposalNo    String? @map("proposal_no")

  // Exact Document Identifiers
  invoiceNo        String  @unique @map("invoice_no")
  costEstimationNo String? @map("cost_estimation_no")

  // Client Snapshot
  clientName    String  @map("client_name")
  clientCompany String? @map("client_company")
  country       String?

  // Financial Snapshot
  currency       String  @default("LKR")
  subtotal       Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount    Decimal @map("total_amount") @db.Decimal(12, 2)
  paymentNote    String? @map("payment_note")

  // Bank Detail Snapshot
  bankAccountNo   String? @map("bank_account_no")
  bankAccountName String? @map("bank_account_name")
  bankSwiftCode   String? @map("bank_swift_code")
  bankName        String? @map("bank_name")
  bankBranch      String? @map("bank_branch")
  bankAddress     String? @map("bank_address")
  bankCountry     String? @map("bank_country")

  // Google Drive File Integration
  driveFileId  String? @map("drive_file_id")
  driveFileUrl String? @map("drive_file_url")

  status     InvoiceStatus @default(DRAFT)
  issuedDate DateTime?     @map("issued_date") @db.Date
  dueDate    DateTime?     @map("due_date") @db.Date
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz

  project     Project                 @relation(fields: [projectId], references: [id], onDelete: Restrict)
  participant OutsourcingParticipant? @relation(fields: [participantId], references: [id], onDelete: SetNull)
  milestone   OutsourcingMilestone?   @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  quotation   Quotation?              @relation(fields: [quotationId], references: [id], onDelete: SetNull)

  payments Payment[]

  @@map("invoices")
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

model Payment {
  id        String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  invoiceId String @db.Uuid

  amount      Decimal       @db.Decimal(12, 2)
  paymentDate DateTime      @map("payment_date") @db.Date
  method      String
  referenceNo String?       @map("reference_no")
  status      PaymentStatus @default(PENDING)
  notes       String?       @db.Text
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz

  project Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  invoice Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  proof   PaymentProof?
  receipt Receipt?

  @@map("payments")
}

model PaymentProof {
  id          String   @id @default(uuid()) @db.Uuid
  paymentId   String   @unique @db.Uuid
  driveFileId String   @map("drive_file_id")
  fileName    String   @map("file_name")
  mimeType    String   @map("mime_type")
  url         String?
  uploadedAt  DateTime @default(now()) @map("uploaded_at") @db.Timestamptz

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("payment_proofs")
}

model Receipt {
  id        String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  paymentId String @unique @db.Uuid

  receiptNo String @unique @map("receipt_no")

  // Google Drive File Integration
  driveFileId  String? @map("drive_file_id")
  driveFileUrl String? @map("drive_file_url")

  generatedAt DateTime @default(now()) @map("generated_at") @db.Timestamptz

  project Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  payment Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  items   ReceiptItem[]

  @@map("receipts")
}

model ReceiptItem {
  id          String  @id @default(uuid()) @db.Uuid
  receiptId   String  @db.Uuid
  description String
  quantity    Int     @default(1)
  amount      Decimal @db.Decimal(12, 2)

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@map("receipt_items")
}

// ==================================================
// 5. HR DOCUMENT VAULT & EMPLOYEE MANAGEMENT
// ==================================================

model Employee {
  id            String             @id @default(uuid()) @db.Uuid
  fullName      String             @map("full_name")
  email         String             @unique
  position      String             // e.g., "Intern Software Engineer"
  appointedDate DateTime           @map("appointed_date") @db.Date
  endDate       DateTime?          @map("end_date") @db.Date
  status        String             @default("ACTIVE") // ACTIVE, COMPLETED, RESIGNED
  driveFolderId String?            @map("drive_folder_id") // Dedicated Drive folder for this employee's files
  
  // Relations
  documents     EmployeeDocument[]
  
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  @@map("employees")
}

model EmployeeDocument {
  id          String   @id @default(uuid()) @db.Uuid
  employeeId  String   @map("employee_id") @db.Uuid
  type        String   // "NDA", "BANK_FORM", "LOI", "SERVICE_LETTER", "OTHER"
  fileName    String   @map("file_name")
  mimeType    String   @map("mime_type")
  driveFileId String   @map("drive_file_id")
  url         String   // Direct link to view the file on Google Drive
  
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  uploadedAt  DateTime @default(now()) @map("uploaded_at") @db.Timestamptz

  @@index([employeeId])
  @@map("employee_documents")
}

